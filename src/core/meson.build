# Changed: Created meson build file for core system modules

core_sources = []

# Core system modules
core_sources += files(
  'settings.c',
  'util.c',
  'settings_manager.c',
  'window_lifecycle.c'
)

# Export sources for parent build
core_lib_sources = core_sources