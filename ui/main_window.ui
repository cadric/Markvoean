<?xml version="1.0" encoding="UTF-8"?>
<!-- [1.1.1] - 2025-09-18 - ui/main_window.ui
     PATCH: GNOME HIG-compliant window sizing with adaptive layout support
-->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwApplicationWindow" id="main_window">
    <property name="title" translatable="yes">IFG</property>
    <!-- Window size managed programmatically with GSettings persistence -->
    <accessibility>
      <property name="label" translatable="yes">IFG main window</property>
      <property name="description" translatable="yes">Main application window for editing markdown documents</property>
    </accessibility>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="show-end-title-buttons">true</property>
            <!-- Primary action buttons with adaptive behavior -->
            <child type="start">
              <object class="GtkBox" id="primary_buttons">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="new_tab_button">
                    <property name="icon-name">tab-new-symbolic</property>
                    <property name="tooltip-text" translatable="yes">New Tab</property>
                    <accessibility>
                      <property name="label" translatable="yes">New tab</property>
                      <property name="description" translatable="yes">Create a new document tab</property>
                    </accessibility>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="open_button">
                    <property name="icon-name">document-open-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Open a File</property>
                    <accessibility>
                      <property name="label" translatable="yes">Open file</property>
                      <property name="description" translatable="yes">Open an existing markdown file</property>
                    </accessibility>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_button">
                    <property name="icon-name">document-save-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Save Document</property>
                    <accessibility>
                      <property name="label" translatable="yes">Save document</property>
                      <property name="description" translatable="yes">Save the current document to file</property>
                    </accessibility>
                  </object>
                </child>
                <!-- Save As button - hidden on narrow screens with display:none -->
                <child>
                  <object class="GtkButton" id="save_as_button">
                    <property name="icon-name">document-save-as-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Save Document As...</property>
                    <accessibility>
                      <property name="label" translatable="yes">Save document as</property>
                      <property name="description" translatable="yes">Save the current document to a new file location</property>
                    </accessibility>
                    <style>
                      <class name="adaptive-hide-narrow"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child type="title">
              <object class="AdwTabBar" id="tab_bar">
                <property name="autohide">true</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">primary_menu</property>
                <property name="tooltip-text" translatable="yes">Application menu</property>
                <accessibility>
                  <property name="label" translatable="yes">Application menu</property>
                  <property name="description" translatable="yes">Access application preferences and information</property>
                </accessibility>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwTabView" id="tab_view">
            <accessibility>
              <property name="label" translatable="yes">Document tabs</property>
              <property name="description" translatable="yes">Multiple document tabs</property>
            </accessibility>
            <!-- Tab pages will be added dynamically -->
          </object>
        </child>

        <!-- Adaptive status bar - responsive to window width -->
        <child type="bottom">
          <object class="GtkBox" id="status_bar_container">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
            <property name="margin-top">2</property>
            <property name="margin-bottom">2</property>
            <property name="height-request">24</property>
            <style>
              <class name="statusbar"/>
            </style>

            <child>
              <object class="GtkLabel" id="save_status">
                <property name="label"></property>
                <property name="halign">start</property>
                <property name="width-chars">15</property>
                <property name="max-width-chars">25</property>
                <property name="ellipsize">end</property>
              </object>
            </child>

            <child>
              <object class="GtkSeparator" id="status_separator">
                <property name="orientation">vertical</property>
                <style>
                  <class name="adaptive-hide-narrow"/>
                </style>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="file_location">
                <property name="label"></property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <property name="ellipsize">middle</property>
                <property name="width-chars">20</property>
                <property name="max-width-chars">40</property>
                <style>
                  <class name="adaptive-hide-narrow"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About IFG</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>